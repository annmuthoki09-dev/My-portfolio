<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Management System</title>
    <style>
        /* General page styling */
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f4f6f9;
            color: #333;
        }

        /* Header */
        header {
            background: linear-gradient(rgba(18, 52, 86, 0.85), rgba(18, 52, 86, 0.85)), 
                        url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
            color: white;
            text-align: center;
            padding: 40px 15px;
        }

        header h1 {
            margin: 0 0 10px;
        }

        header p {
            margin: 0;
        }

        /* Navigation */
        nav {
            background-color: #0b2239;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #f4c542;
        }

        /* Main content */
        main {
            width: 95%;
            max-width: 1400px;
            margin: 25px auto;
        }

        section {
            background-color: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        h2 {
            color: #123456;
            margin-top: 0;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 12px;
        }

        /* Dashboard cards */
        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
        }

        .card {
            background-color: #123456;
            color: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }

        .card h3 {
            font-size: 16px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        /* Form */
        form {
            max-width: 650px;
        }

        label {
            display: block;
            margin-top: 15px;
            margin-bottom: 7px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 15px;
        }

        input:focus,
        select:focus {
            outline: 2px solid #2878b5;
            border-color: transparent;
        }

        /* Room Preview Image Container */
        .room-preview-box {
            margin-top: 12px;
            display: none;
        }

        .room-preview-box img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #ddd;
        }

        /* Price display */
        .price-box {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin: 20px 0;
            padding: 15px;
            background-color: #eaf4ff;
            border-radius: 5px;
        }

        #totalPrice {
            font-weight: bold;
            color: #123456;
        }

        /* Buttons */
        button {
            background-color: #123456;
            color: white;
            border: none;
            padding: 12px 18px;
            margin: 5px 5px 5px 0;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        button:hover {
            opacity: 0.85;
        }

        .secondary-button {
            background-color: #6c757d;
        }

        .checkin-button {
            background-color: #198754;
        }

        .checkout-button {
            background-color: #0d6efd;
        }

        .cancel-button {
            background-color: #dc3545;
        }

        /* Messages */
        #message {
            font-weight: bold;
            margin-top: 15px;
        }

        /* Search */
        #searchBooking {
            margin-bottom: 20px;
            max-width: 450px;
        }

        /* Booking table */
        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1100px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #123456;
            color: white;
        }

        tbody tr:nth-child(even) {
            background-color: #f2f6fa;
        }

        tbody tr:hover {
            background-color: #eaf4ff;
        }

        td button {
            margin: 3px;
            white-space: nowrap;
        }

        /* Status labels */
        .status {
            display: inline-block;
            padding: 5px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-Booked {
            background-color: #fff3cd;
            color: #664d03;
        }

        .status-Checked-in {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .status-Checked-out {
            background-color: #cfe2ff;
            color: #084298;
        }

        .status-Cancelled {
            background-color: #f8d7da;
            color: #842029;
        }

        /* Footer */
        footer {
            background-color: #0b2239;
            color: white;
            text-align: center;
            padding: 18px;
            margin-top: 30px;
        }

        /* Responsive layout */
        @media (max-width: 800px) {
            .dashboard-cards {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            nav a {
                display: inline-block;
                margin: 7px;
            }

            section {
                padding: 15px;
            }
        }

        @media (max-width: 450px) {
            .dashboard-cards {
                grid-template-columns: 1fr;
            }

            header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>🏨 Grand Palace Hotel</h1>
        <p>Hotel Management System</p>
    </header>

    <nav>
        <a href="#dashboard">Dashboard</a>
        <a href="#booking">New Booking</a>
        <a href="#bookings">Manage Bookings</a>
    </nav>

    <main>

        <!-- Dashboard -->
        <section id="dashboard">
            <h2>Dashboard</h2>

            <div class="dashboard-cards">
                <div class="card">
                    <h3>Total Rooms</h3>
                    <p id="totalRooms">10</p>
                </div>

                <div class="card">
                    <h3>Available Rooms</h3>
                    <p id="availableRooms">10</p>
                </div>

                <div class="card">
                    <h3>Active Bookings</h3>
                    <p id="activeBookings">0</p>
                </div>

                <div class="card">
                    <h3>Checked-in Guests</h3>
                    <p id="checkedInGuests">0</p>
                </div>
            </div>
        </section>

        <!-- Booking Form -->
        <section id="booking">
            <h2>Register a Guest / New Booking</h2>

            <form id="bookingForm">
                <label for="guestName">Guest Full Name:</label>
                <input type="text" id="guestName" placeholder="Enter guest name" required>

                <label for="phone">Phone Number:</label>
                <input type="tel" id="phone" placeholder="Enter phone number" required>

                <label for="roomType">Room Type:</label>
                <select id="roomType" required>
                    <option value="">Select Room Type</option>
                    <option value="Single">Single Room - KSh 2,000</option>
                    <option value="Double">Double Room - KSh 3,500</option>
                    <option value="Deluxe">Deluxe Room - KSh 5,000</option>
                    <option value="Suite">Suite - KSh 8,000</option>
                </select>

                <!-- Room Image Preview -->
                <div id="roomPreviewBox" class="room-preview-box">
                    <img id="roomImage" src="" alt="Room Preview">
                </div>

                <label for="checkIn">Check-in Date:</label>
                <input type="date" id="checkIn" required>

                <label for="checkOut">Check-out Date:</label>
                <input type="date" id="checkOut" required>

                <div class="price-box">
                    <strong>Estimated Total:</strong>
                    <span id="totalPrice">KSh 0</span>
                </div>

                <button type="submit">Book Room</button>
                <button type="reset" class="secondary-button" id="resetBtn">Clear Form</button>
            </form>

            <p id="message" role="status"></p>
        </section>

        <!-- Booking Records -->
        <section id="bookings">
            <h2>Guest Bookings</h2>

            <input type="search" id="searchBooking" placeholder="Search by guest name or phone..." aria-label="Search bookings">

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Guest Name</th>
                            <th>Phone</th>
                            <th>Room</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Total (KSh)</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="bookingTable">
                        <!-- JavaScript inserts bookings here -->
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <footer>
        <p>&copy; 2026 Grand Palace Hotel | Hotel Management System</p>
    </footer>

    <script>
        // Room prices per night in Kenyan Shillings
        const roomPrices = {
            Single: 2000,
            Double: 3500,
            Deluxe: 5000,
            Suite: 8000
        };

        // Room preview image URLs
        const roomImages = {
            Single: "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=600&q=80",
            Double: "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80",
            Deluxe: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
            Suite: "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80"
        };

        // Capacity configuration
        const roomCapacity = {
            Single: 3,
            Double: 3,
            Deluxe: 2,
            Suite: 2
        };

        const TOTAL_ROOMS = Object.values(roomCapacity).reduce((sum, count) => sum + count, 0);

        // DOM elements
        const bookingForm = document.getElementById("bookingForm");
        const guestName = document.getElementById("guestName");
        const phone = document.getElementById("phone");
        const roomType = document.getElementById("roomType");
        const roomPreviewBox = document.getElementById("roomPreviewBox");
        const roomImage = document.getElementById("roomImage");
        const checkIn = document.getElementById("checkIn");
        const checkOut = document.getElementById("checkOut");
        const totalPrice = document.getElementById("totalPrice");
        const bookingTable = document.getElementById("bookingTable");
        const searchBooking = document.getElementById("searchBooking");
        const message = document.getElementById("message");
        const resetBtn = document.getElementById("resetBtn");

        let bookings = [];

        try {
            const savedBookings = localStorage.getItem("hotelBookings");
            if (savedBookings) {
                const parsed = JSON.parse(savedBookings);
                if (Array.isArray(parsed)) bookings = parsed;
            }
        } catch (error) {
            console.error("Could not load saved bookings:", error);
        }

        // Helper Functions
        function formatMoney(amount) {
            return "KSh " + Number(amount).toLocaleString("en-KE");
        }

        function escapeHTML(value) {
            return String(value).replace(/[&<>"']/g, char => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
            })[char]);
        }

        function saveBookings() {
            try {
                localStorage.setItem("hotelBookings", JSON.stringify(bookings));
                return true;
            } catch (error) {
                showMessage("Unable to save data. Check your browser storage.", true);
                return false;
            }
        }

        function showMessage(text, isError = false) {
            message.textContent = text;
            message.style.color = isError ? "#dc3545" : "#198754";
        }

        function generateBookingId() {
            return "BK-" + Date.now() + "-" + Math.floor(Math.random() * 1000);
        }

        function dateNumber(dateString) {
            const parts = dateString.split("-").map(Number);
            return Date.UTC(parts[0], parts[1] - 1, parts[2]) / 86400000;
        }

        function calculateNights(start, end) {
            return dateNumber(end) - dateNumber(start);
        }

        function datesOverlap(start1, end1, start2, end2) {
            return dateNumber(start1) < dateNumber(end2) && dateNumber(end1) > dateNumber(start2);
        }

        function getOccupiedRooms(type, start, end, excludeId = null) {
            return bookings.filter(b => {
                if (b.roomType !== type || b.id === excludeId) return false;
                if (b.status === "Cancelled" || b.status === "Checked-out") return false;
                return datesOverlap(start, end, b.checkIn, b.checkOut);
            }).length;
        }

        function isRoomAvailable(type, start, end, excludeId = null) {
            return getOccupiedRooms(type, start, end, excludeId) < roomCapacity[type];
        }

        function updateTotalPrice() {
            const type = roomType.value;
            const start = checkIn.value;
            const end = checkOut.value;

            if (!type || !start || !end) {
                totalPrice.textContent =
